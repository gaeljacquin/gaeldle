{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "strict": false,
    "noUncheckedIndexedAccess": false,
    "verbatimModuleSyntax": false,
    "paths": {
      "@/*": ["../api/src/*"],
      "@workspace/db": ["../../packages/db/src/schema/index.ts"],
      "@workspace/shared": ["../../packages/shared/src/index.ts"],
      "@workspace/queue": ["../../packages/queue/src/index.ts"]
    }
  },
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS",
      "moduleResolution": "Node",
      "esModuleInterop": true
    }
  },
  "include": [
    "src/**/*",
    "../api/src/**/*",
    "../../packages/db/src/**/*",
    "../../packages/shared/src/**/*",
    "../../packages/queue/src/**/*"
  ]
}
