{
  "name": "gaeldle",
  "author": "Gaël Jacquin",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "codegen": "pnpm --filter @workspace/api-client generate",
    "dev": "turbo run dev",
    "lint": "turbo lint --filter '!@workspace/ui'",
    "lint:fix": "turbo lint --filter '!@workspace/ui' -- --fix",
    "lint:web": "turbo lint --filter @workspace/web",
    "db:generate": "pnpm --filter @workspace/db db:generate",
    "db:migrate": "pnpm --filter @workspace/db db:migrate",
    "db:push": "pnpm --filter @workspace/db db:push",
    "db:studio": "pnpm --filter @workspace/db db:studio",
    "test": "turbo test",
    "test:web": "turbo test --filter @workspace/web",
    "format": "prettier --check .",
    "format:write": "prettier --write . --ignore-unknown",
    "typecheck": "turbo typecheck",
    "add:web": "pnpm --filter ./apps/web add",
    "add:api": "pnpm --filter ./apps/api add",
    "add:ui": "pnpm --filter ./packages/ui add",
    "sync": "./start-remote-sync.sh",
    "sync:list": "mutagen sync list",
    "sync:list-long": "mutagen sync list --long",
    "sync:monitor": "mutagen sync monitor gaeldle",
    "sync:pause": "mutagen sync pause gaeldle",
    "sync:resume": "mutagen sync resume gaeldle",
    "sync:terminate": "./stop-remote-sync.sh",
    "sync:reset": "mutagen sync reset gaeldle",
    "prepare": "husky"
  },
  "keywords": [],
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12"
  },
  "dependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  }
}
