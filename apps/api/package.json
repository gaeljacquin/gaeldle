{
  "name": "@workspace/api",
  "private": true,
  "exports": {
    "./db": "./src/db/schema/index.ts"
  },
  "scripts": {
    "build": "nest build",
    "codegen": "pnpm generate:openapi",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "start": "nest start",
    "dev": "INFISICAL_DISABLE_KEYRING=true ../../scripts/infisical-dev.sh run --path=/api --env=dev -- nest start --watch || nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "format": "prettier --check .",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "INFISICAL_DISABLE_KEYRING=true ../../scripts/infisical-dev.sh run --path=/api --env=dev -- drizzle-kit migrate || drizzle-kit migrate",
    "db:push": "INFISICAL_DISABLE_KEYRING=true ../../scripts/infisical-dev.sh run --path=/api --env=dev -- drizzle-kit push || drizzle-kit push",
    "db:studio": "INFISICAL_DISABLE_KEYRING=true ../../scripts/infisical-dev.sh run --path=/api --env=dev -- drizzle-kit studio || drizzle-kit studio",
    "db:refresh-all-mat-views": "INFISICAL_DISABLE_KEYRING=true ../../scripts/infisical-dev.sh run --path=/api --env=dev -- ts-node --compiler-options '{\"module\": \"commonjs\"}' src/db/refresh-all-mat-views.ts || ts-node --compiler-options '{\"module\": \"commonjs\"}' src/db/refresh-all-mat-views.ts",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:cov": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_OPTIONS='--experimental-vm-modules' jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1120.0",
    "@aws-sdk/client-s3": "^3.1120.0",
    "@aws-sdk/client-sqs": "^3.1120.0",
    "@aws-sdk/s3-request-presigner": "^3.1120.0",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@workspace/shared": "workspace:*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "jose": "^6.2.10",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "jest": "^30.5.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@workspace/api/db$": "<rootDir>/db/schema/index.ts",
      "^@workspace/shared$": "<rootDir>/../../../packages/shared/src/index.ts"
    },
    "extensionsToTreatAsEsm": [
      ".ts"
    ]
  }
}
