{
  "name": "Gaeldle Dev Container",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/gaeldle",
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "yoavbls.pretty-ts-errors",
        "ms-python.pylance",
        "ms-python.python",
        "ms-python.debugpy",
        "ms-python.python-environment-manager",
        "ms-vscode-remote.remote-ssh",
        "ms-vscode-remote.remote-ssh-edit",
        "ms-vscode.remote-tunnels",
        "ms-vscode.remote-explorer",
        "bradlc.vscode-tailwindcss",
        "ms-playwright.playwright",
        "alefragnani.Bookmarks",
        "streetsidesoftware.code-spell-checker",
        "dbaeumer.vscode-eslint",
        "openai.chatgpt",
        "kisstkondoros.vscode-gutter-preview",
        "IBM.output-colorizer",
        "quicktype.quicktype",
        "YoavBls.pretty-ts-errors",
        "ms-vscode.remote-server",
        "ms-vscode-remote.remote-containers"
      ],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit"
        },
        "js/ts.tsdk": "node_modules/typescript/lib",
        "npm.packageManager": "pnpm",
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  },
  "forwardPorts": [3000, 8080],
  "remoteUser": "root",
  "containerEnv": {
    "SHELL": "/bin/zsh"
  },
  "mounts": [
    "source=${localEnv:HOME}/.codex/auth.json,target=/root/.codex/auth.json,type=bind,consistency=cached"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
