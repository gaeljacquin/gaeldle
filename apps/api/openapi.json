  "info": {
    "title": "Gaeldle API",
    "description": "The Gaeldle API specification",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "SyncGameDto": {
        "type": "object",
        "properties": {
          "igdb_id": {
            "type": "number",
            "description": "IGDB ID of the game",
            "example": 1234
          }
        },
        "required": [
          "igdb_id"
        ]
      },
      "SyncGameDataDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "igdbId": {
            "type": "number"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "igdbId",
          "name"
        ]
      },
      "SyncGameResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "operation": {
            "type": "string",
            "enum": [
              "created",
              "updated"
            ]
          },
          "data": {
            "$ref": "#/components/schemas/SyncGameDataDto"
          }
        },
        "required": [
          "success",
          "message",
          "operation",
          "data"
        ]
